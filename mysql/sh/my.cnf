[mysqld]
server_id=20001
default-time-zone=+08:00
log_timestamps=system
gtid_mode=ON
enforce-gtid-consistency=ON
character-set-server=utf8mb4
#collation-server=utf8mb4_general_ci     # 5.7
collation-server=utf8mb4_0900_ai_ci     # 8.4 默认，比 general_ci 更标准

log-bin=mysql-bin
# binlog-format=ROW     # 5.7可用, 8.4废弃
# binlog中显示sql语句
binlog-rows-query-log-events=ON

binlog-ignore-db=mysql,information_schema,performance_schema
#8.4
binlog_expire_logs_seconds=604800      # 替代 5.7 expire_logs_days
# 需要同步的数据库
# binlog_do_db=boot
# 确保binlog日志写入后与硬盘同步, 0:性能好,风险大,系统Crash,在binlog_cache中数据会丢失
sync_binlog=1
#log-slave-updates=ON     # 5.7
log-replica-updates=ON     # 8.4

# 日志输出到文件/数据库,都输出用,分割,默认只输出到FILE.加上TABLE后会输出在mysql.general_log,slow_log
# log_output='FILE,TABLE'

general_log=0
# general_log_file=xxx
# 错误日志
# log-error=/var/lib/mysql/error.log
# 慢查询日志
slow_query_log=1
slow_query_log_file=/var/log/mysql/slow.log
long_query_time=2
# ---- 表名大小写（Linux 推荐）----
#lower_case_table_names=0 # 0: 区分大小写 1: 不区分 2: mac

wait_timeout=28800

# 最大允许传输包的大小
max_allowed_packet=64M

# 最大连接数
max_connections=5000

# 1.group by相关
# sql_mode='STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'

# ---- 8.4 新默认值（显式写更稳）----
innodb_redo_log_capacity=2G
innodb_flush_method=O_DIRECT
innodb_io_capacity=10000
innodb_adaptive_hash_index=OFF
innodb_change_buffering=none
authentication_policy=caching_sha2_password,


[mysql]
# 设置mysql客户端默认字符集
default-character-set=utf8mb4

[mysqldump]
max_allowed_packet=64M
single-transaction
routines
triggers

[client]
port=3306
default-character-set=utf8mb4
